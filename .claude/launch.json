{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/api"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/web"
      ],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "apps/web"
      ],
      "port": 3100
    },
    {
      "name": "pages-public",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/demo/scripts/serve.mjs", "apps/web/public", "/windgaurd", "3200"],
      "port": 3200
    },
    {
      "name": "pages",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/demo/scripts/serve.mjs", "apps/web/out", "/windgaurd", "3200"],
      "port": 3200
    }
  ]
}