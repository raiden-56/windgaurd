{
  "name": "windguard",
  "version": "1.0.0",
  "private": true,
  "description": "WINDGUARD - Workforce Attendance & Site Operations Management Platform",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/demo"
  ],
  "scripts": {
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "pages:build": "node scripts/pages-build.mjs",
    "pages:deploy": "node scripts/pages-deploy.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.7.0-beta.19"
  }
}
